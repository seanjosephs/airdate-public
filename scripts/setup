#!/bin/zsh
# One-time (and safe to re-run) setup for airdate.
# Creates the Substack venv from requirements-substack.txt and the private
# runtime folder. Changes nothing outside this folder.
set -eu

APP_DIR="$(cd "$(dirname "$0")/.." && pwd)"
cd "$APP_DIR"

# python-substack needs Python 3.10 or newer; macOS's built-in python3 is 3.9.
PYTHON=""
for candidate in python3.13 python3.12 python3.11 python3.10 python3; do
  if command -v "$candidate" >/dev/null 2>&1 && "$candidate" -c 'import sys; sys.exit(0 if sys.version_info >= (3, 10) else 1)' 2>/dev/null; then
    PYTHON="$(command -v "$candidate")"
    break
  fi
done
if [ -z "$PYTHON" ]; then
  echo "airdate needs Python 3.10 or newer for its Substack client."
  echo "macOS ships 3.9, so install a newer one. Either works:"
  echo "  - Installer: https://www.python.org/downloads/  (no package manager needed)"
  echo "  - Homebrew:  brew install python@3.12"
  echo "    No 'brew' command? Install Homebrew first: https://brew.sh"
  echo "Then run scripts/setup again."
  exit 1
fi
echo "Using $PYTHON ($("$PYTHON" -c 'import platform; print(platform.python_version())'))"

if [ ! -x .venv-substack/bin/python ]; then
  echo "Creating .venv-substack..."
  "$PYTHON" -m venv .venv-substack
fi
echo "Installing the pinned Substack client..."
.venv-substack/bin/python -m pip install --quiet --upgrade pip
.venv-substack/bin/python -m pip install --quiet -r requirements-substack.txt

mkdir -p .airdate-data/secrets .airdate-data/state
chmod 700 .airdate-data .airdate-data/secrets .airdate-data/state

echo
echo "Setup done."
echo "Next:"
echo "  1. ./run-airdate.command   (opens airdate; first run asks for your vault)"
echo "  2. python3 scripts/install-connector   (after first run; copies the Obsidian connector into your vault)"
echo "  3. In Obsidian: enable 'airdate connector', then run 'Pair with airdate' and 'Connect Substack for airdate'."
echo "SETUP.md has the details."
